# Copy to .env (development) or .env.production (server). Never commit real values.

NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Behind Caddy/a load balancer in production:
TRUST_PROXY=false

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://tabeeby:CHANGE_ME@localhost:5432/tabeeby
DATABASE_POOL_SIZE=10
# disable | require (encrypted + certificate verified) | no-verify
DATABASE_SSL=disable
# DATABASE_SSL_CA_FILE=/etc/ssl/certs/db-ca.pem

# --- Private uploads (syndicate cards). Not web-served; back it up. ----------
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=10485760

# --- SMS ---------------------------------------------------------------------
# 'console' prints messages (dev only — refused in production).
SMS_PROVIDER=console
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://your-sms-gateway.example/send
# SMS_HTTP_TOKEN=
SMS_SENDER_ID=Tabeeby

# --- Email ---------------------------------------------------------------------
# Unset: prints emails to the log in development, off in production.
# Set BREVO_API_KEY and EMAIL_FROM to send real emails through Brevo.
# BREVO_API_KEY=
# EMAIL_FROM=you@example.com
# EMAIL_FROM_NAME=Tabeeby

# --- Booking rules -------------------------------------------------------------
CANCEL_CUTOFF_HOURS=2
BOOKING_HORIZON_DAYS=14
BOOKING_MIN_LEAD_MINUTES=30
MAX_ACTIVE_APPOINTMENTS_PER_PATIENT=5
NO_SHOW_LIMIT=3
NO_SHOW_WINDOW_DAYS=180
STRIKE_LIMIT=5
STRIKE_WINDOW_DAYS=180
TIME_ZONE=Africa/Cairo

LOG_LEVEL=info
RUN_WORKER=true

# --- Production compose only ----------------------------------------------------
# DOMAIN=tabeeby.com
# ACME_EMAIL=ops@tabeeby.com
# POSTGRES_PASSWORD=
