{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	# Uploads are capped in the app too; this stops oversized bodies early.
	request_body {
		max_size 11MB
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
	log {
		output stdout
		format json
	}
}
